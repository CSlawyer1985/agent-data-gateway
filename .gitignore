# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# ADG 输出（三层目录契约：input 只读，产物去 output）
adg-output/
output/
scratch/
**/expanded/
**/documents/
**/work/
**/logs/

# 测试与自检临时产物
.pytest_cache/
.coverage
adg-verify-*/

# 用户材料（永不提交）
input/
*.local

# worker 本地模型权重（体积大且机器相关，经 --worker-option 注入路径使用）
workers/*/models/

# 本地 harness（迭代纪律等，不随仓库分发）
.claude/

# IDE
.idea/
.vscode/
.DS_Store
