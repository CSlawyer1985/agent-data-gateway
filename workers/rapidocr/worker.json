{
  "name": "rapidocr",
  "version": "0.1.0",
  "handles": [{"kind": "image", "role": "parse"}],
  "requirements": {"min_ram_mb": 2048, "gpu": "none", "backend": ["subprocess"], "network": false},
  "subprocess": {"adapter": "adapter.py", "venv": ".venv", "probe_import": "rapidocr_onnxruntime"},
  "python_requires": ["rapidocr-onnxruntime", "pillow"],
  "weight": "heavy",
  "maturity": "implemented",
  "license": "Apache-2.0",
  "notes": "图片 OCR（rapidocr-onnxruntime，基于 PaddleOCR 模型 + onnxruntime 推理）。paddleocr 在新 Python 无 wheel 时的友好替代；模型随包安装，无需联网下载。中文识别效果好。"
}
